# ── 内部状态 ─────────────────────────────────────────────────────
# WorkBuddy 工作区数据，不参与交付。
# 本项目仓库根是 jimeng-console/，正常情况下根本不含它；这里做防御性忽略，
# 避免将来在更高层级 init 时把它误提交上去。
.workbuddy/

# ── 临时 / 验证产物 ──────────────────────────────────────────────
# 无头浏览器验证用的临时文件，约定以 _ 前缀命名、用完即删（见 README）。
# 只忽略仓库根与 app/ 两处，不做全局 _* 匹配，免得误伤 _config.yml 这类正常文件。
/_*
/app/_*
*.tmp

# ── 依赖与缓存 ──────────────────────────────────────────────────
node_modules/
*.log
.cache/

# ── 后端运行时数据（server/data）────────────────────────────────
# db.json / output/ / assets/ 均为运行态产物，且可能含生成素材，不入库
server/data/

# ── 编辑器 / IDE ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── 操作系统 ────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── 环境变量与密钥：绝不允许入库 ────────────────────────────────
.env
.env.*
*.pem
*.key
*.p12

# ── 构建产物 ────────────────────────────
# dist/ 由 node build.js 从 app/ 内联生成，可随时重建，不入库
dist/

# ── 本地备份 ───────────────────────────
# 历史快照与手工备份，内部留档用
backup/
